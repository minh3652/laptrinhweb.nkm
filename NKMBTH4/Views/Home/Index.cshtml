@{
    ViewData["Title"] = "Home Page";
}

@await Html.PartialAsync("~/Views/Shared/Banner.cshtml")

<h2>Home Page</h2>

<button id="loadAjax" class="btn btn-primary">
    Click load book từ partialResult
</button>

<br />
<br />

<div id="data-from-ajax" class="row">
    Loading data...
</div>

<h2>Popular Book Load từ BookComponent</h2>

@await Component.InvokeAsync("Book")

@section Scripts
{
    <script>
        $(document).ready(function () {

            $("#loadAjax").click(function () {

                $("#data-from-ajax").load("/Book/PopularBook");

            });

        });
    </script>
}