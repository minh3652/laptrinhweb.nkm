<!-- Begin Header -->
<div class="header">
	<div class="header_top">
		<div class="logo">
			<a href="index.html"><img src="images/logo.png" alt="" /></a>
		</div>
		<div class="cart">
			<p>
				Welcome to our Online Store! <span>Cart:</span><div id="dd" class="wrapper-dropdown-2">
				0 item(s) - $0.00
				
			</div>
		</p>
	</div>
	<div class="clear"></div>
</div>
<div class="header_bottom">
	<div class="menu">
		<ul>
			@if (Model != null)
{
    foreach (var item in Model)
    {
        <li>
            <a href="/Home/LocHangHoa?maLoai=@item.MaLoai"
               class="loc-loai-hang"
               data-maloai="@item.MaLoai">
                @item.TenLoai
            </a>
        </li>
    }
}
				<div class="clear"></div>
		</ul>
	</div>
	<div class="search_box">
		<form>
			<input type="text" value="Search"/>
			<input type="button" value="" />
		</form>
	</div>
	<div class="clear"></div>
</div>
</div>
<!-- End Header -->