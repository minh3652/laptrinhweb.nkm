@model List<nkmsession5.Models.DataModels.Member>

<h2>Danh sách thành viên</h2>

<a asp-action="Create" class="btn btn-primary">Đăng ký thành viên</a>

<br />
<br />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>MemberId</th>
            <th>UserName</th>
            <th>FullName</th>
            <th>Password</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Birthday</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>@member.MemberId</td>
                <td>@member.UserName</td>
                <td>@member.FullName</td>
                <td>@member.Password</td>
                <td>@member.Email</td>
                <td>@member.Phone</td>
                <td>@member.Birthday.ToString("dd/MM/yyyy")</td>
            </tr>
        }
    </tbody>
</table>