@model NKmlap6_.Models.NkmMember

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>NkmMember</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="NkmEdit" method="post">

            <input type="hidden" asp-for="NkmMemberId" />

            <div class="form-group">
                <label asp-for="NkmMemberUserName" class="control-label"></label>
                <input asp-for="NkmMemberUserName" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="NkmMemberPassword" class="control-label"></label>
                <input asp-for="NkmMemberPassword" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="NkmMemberEmail" class="control-label"></label>
                <input asp-for="NkmMemberEmail" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="NkmMemberPhone" class="control-label"></label>
                <input asp-for="NkmMemberPhone" class="form-control" />
            </div>

            <br />

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>