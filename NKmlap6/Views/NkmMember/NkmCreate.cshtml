@model NKmlap6_.Models.NkmMember

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>NkmMember</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="NkmCreate" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="NkmMemberUserName" class="control-label"></label>
                <input asp-for="NkmMemberUserName" class="form-control" />
                <span asp-validation-for="NkmMemberUserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NkmMemberPassword" class="control-label"></label>
                <input asp-for="NkmMemberPassword" class="form-control" />
                <span asp-validation-for="NkmMemberPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NkmMemberEmail" class="control-label"></label>
                <input asp-for="NkmMemberEmail" class="form-control" />
                <span asp-validation-for="NkmMemberEmail" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NkmMemberPhone" class="control-label"></label>
                <input asp-for="NkmMemberPhone" class="form-control" />
                <span asp-validation-for="NkmMemberPhone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div>
